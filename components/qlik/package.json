{
  "name": "qlik",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.1",
  "scripts": {
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "build": "npm run format && npm run lint && tsdown",
    "typecheck": "tsc --noEmit",
    "publish": "npm run build && prism components:publish",
    "generate:manifest": "npm run build && npx @prismatic-io/spectral component-manifest",
    "generate:manifest:dev": "npm run build && npx @prismatic-io/spectral component-manifest --skip-signature-verify",
    "test": "vitest run"
  },
  "dependencies": {
    "@prismatic-io/spectral": "10.34.0",
    "jsonwebtoken": "^9.0.2",
    "uid-safe": "^2.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/uid-safe": "^2.1.3",
    "form-data": "^4.0.0",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
