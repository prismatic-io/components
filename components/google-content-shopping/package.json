{
  "name": "google-content-shopping",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "build": "webpack",
    "test": "jest --passWithNoTests",
    "build:testapp": "npm run build",
    "publish": "npm run build && prism components:publish",
    "generate:manifest": "npm run build && npx @prismatic-io/spectral component-manifest",
    "generate:manifest:dev": "npm run build && npx @prismatic-io/spectral component-manifest --skip-signature-verify"
  },
  "dependencies": {
    "@prismatic-io/spectral": "10.21.0",
    "googleapis": "^118.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/jest": "30.0.0",
    "@types/node": "18.19.130",
    "copy-webpack-plugin": "14.0.0",
    "jest": "30.4.2",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.109.0",
    "webpack-cli": "6.0.1"
  }
}
