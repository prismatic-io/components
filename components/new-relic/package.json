{
  "name": "@prismatic-io/new-relic",
  "private": true,
  "scripts": {
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "build": "npm run format && npm run lint && webpack",
    "publish": "npm run build && prism components:publish",
    "generate:manifest": "npm run build && npx @prismatic-io/spectral component-manifest",
    "generate:manifest:dev": "npm run build && npx @prismatic-io/spectral component-manifest --skip-signature-verify",
    "test": "echo 'no tests'"
  },
  "dependencies": {
    "@prismatic-io/spectral": "10.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/jest": "30.0.0",
    "@types/node": "^26",
    "copy-webpack-plugin": "14.0.0",
    "jest": "30.4.2",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2"
  }
}
