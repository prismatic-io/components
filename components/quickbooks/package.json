{
  "name": "@prismatic-io/quickbooks",
  "private": true,
  "scripts": {
    "build": "npm run format && npm run lint && tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "publish": "npm run build && prism components:publish",
    "generate:manifest": "npm run build && npx @prismatic-io/spectral component-manifest",
    "generate:manifest:dev": "npm run build && npx @prismatic-io/spectral component-manifest --skip-signature-verify"
  },
  "dependencies": {
    "@prismatic-io/spectral": "10.34.1",
    "form-data": "^4.0.0",
    "intuit-oauth": "2.1.0",
    "verify-quickbooks-webhooks": "1.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^26.6.4",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  }
}
