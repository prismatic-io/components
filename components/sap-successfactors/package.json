{
  "name": "@prismatic-io/components-sap-successfactors",
  "version": "0.1.0",
  "main": "./npm-dist/index.cjs",
  "types": "./npm-dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./npm-dist/index.d.cts",
      "default": "./npm-dist/index.cjs"
    }
  },
  "description": "SAP SuccessFactors is a human resources platform that provides cloud-based solutions to manage various HR functions such as business alignment, people performance, recruitment, and learning activities.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prismatic-io/components.git",
    "directory": "components/sap-successfactors"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "npm-dist",
    "dist"
  ],
  "prismatic": {
    "component": "./dist/index.js"
  },
  "scripts": {
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "build": "npm run format && npm run lint && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests'",
    "prepare": "npm run build",
    "publish:platform": "npm run build && prism components:publish"
  },
  "peerDependencies": {
    "@prismatic-io/spectral": "^10.39.2"
  },
  "dependencies": {
    "saml": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^26.6.4",
    "@types/saml": "^1.0.4",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "@prismatic-io/spectral": "^10.39.2",
    "build-config": "file:../../packages/build-config"
  }
}
