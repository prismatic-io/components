{
  "name": "@prismatic-io/pdq",
  "private": true,
  "scripts": {
    "generate:manifest": "npm run build && npx @prismatic-io/spectral component-manifest",
    "generate:manifest:dev": "npm run build && npx @prismatic-io/spectral component-manifest --skip-signature-verify",
    "build": "npm run format && npm run lint && webpack",
    "publish": "npm run build && prism components:publish",
    "test": "jest",
    "lint": "biome check . --write",
    "format": "biome format . --write"
  },
  "dependencies": {
    "@prismatic-io/spectral": "10.25.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/jest": "30.0.0",
    "@types/node": "^26",
    "copy-webpack-plugin": "14.0.0",
    "jest": "30.4.2",
    "nock": "14.0.17",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2"
  }
}
