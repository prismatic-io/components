{
  "name": "canny",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "webpack",
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "test": "jest",
    "publish": "npm run build && prism components:publish",
    "generate:manifest": "npm run build && npx @prismatic-io/spectral component-manifest",
    "generate:manifest:dev": "npm run build && npx @prismatic-io/spectral component-manifest --skip-signature-verify"
  },
  "dependencies": {
    "@prismatic-io/spectral": "10.29.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/jest": "30.0.0",
    "@types/node": "^26.4.1",
    "copy-webpack-plugin": "14.0.0",
    "jest": "30.3.0",
    "nock": "13.5.6",
    "ts-jest": "29.4.9",
    "ts-loader": "9.5.7",
    "typescript": "6.0.3",
    "webpack": "5.106.2",
    "webpack-cli": "7.0.2"
  }
}
