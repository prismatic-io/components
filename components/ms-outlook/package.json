{
  "name": "@prismatic-io/components-ms-outlook",
  "version": "0.4.1",
  "main": "./npm-dist/index.cjs",
  "types": "./npm-dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./npm-dist/index.d.cts",
      "default": "./npm-dist/index.cjs"
    }
  },
  "description": "Manage emails, calendar events, and subscriptions in Microsoft Outlook.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prismatic-io/components.git",
    "directory": "components/ms-outlook"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "npm-dist",
    "dist"
  ],
  "prismatic": {
    "component": "./dist/index.js"
  },
  "scripts": {
    "build": "npm run format && npm run lint && tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "prepare": "npm run build",
    "publish:platform": "npm run build && prism components:publish"
  },
  "peerDependencies": {
    "@prismatic-io/spectral": "^10.39.1"
  },
  "dependencies": {
    "lodash.isempty": "^4.4.0",
    "mailparser": "3.14.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@microsoft/microsoft-graph-types": "2.26.0",
    "@prismatic-io/spectral": "^10.39.1",
    "@types/lodash.isempty": "^4.4.9",
    "@types/node": "^26.6.5",
    "ms-utils": "file:../../packages/ms-utils",
    "nock": "^14.0.17",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "build-config": "file:../../packages/build-config"
  }
}
