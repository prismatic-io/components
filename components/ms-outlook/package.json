  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@microsoft/microsoft-graph-types": "2.26.0",
    "@types/lodash.isempty": "^4.4.9",
    "@types/mailparser": "3.4.0",
    "@types/node": "^26.6.5",
    "typescript": "6.0.3",
    "tsdown": "0.22.3",
    "vitest": "4.1.9"
  }
