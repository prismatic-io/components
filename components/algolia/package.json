{
  "name": "@prismatic-io/components-algolia",
  "version": "0.2.0",
  "main": "./npm-dist/index.cjs",
  "types": "./npm-dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./npm-dist/index.d.cts",
      "default": "./npm-dist/index.cjs"
    }
  },
  "description": "Manage search indexes, records, and settings in Algolia.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prismatic-io/components.git",
    "directory": "components/algolia"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "npm-dist",
    "dist"
  ],
  "prismatic": {
    "component": "./dist/index.js"
  },
  "scripts": {
    "build": "npm run format && npm run lint && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "npm run build",
    "publish:platform": "npm run build && prism components:publish"
  },
  "peerDependencies": {
    "@prismatic-io/spectral": "^10.39.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^26",
    "nock": "^15.0.1",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.3",
    "@prismatic-io/spectral": "^10.39.0"
  }
}
