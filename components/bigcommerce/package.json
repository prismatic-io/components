{
  "name": "@prismatic-io/components-bigcommerce",
  "version": "0.1.0",
  "main": "./npm-dist/index.cjs",
  "types": "./npm-dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./npm-dist/index.d.cts",
      "default": "./npm-dist/index.cjs"
    }
  },
  "description": "Manage products, brands, categories, and more on the BigCommerce ecommerce platform.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prismatic-io/components.git",
    "directory": "components/bigcommerce"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "npm-dist",
    "dist"
  ],
  "prismatic": {
    "component": "./dist/index.js"
  },
  "scripts": {
    "build": "npm run format && npm run lint && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "npm run build",
    "publish:platform": "npm run build && prism components:publish --no-confirm"
  },
  "peerDependencies": {
    "@prismatic-io/spectral": "^10.38.5"
  },
  "dependencies": {
    "form-data": "^4.0.0",
    "qs": "^6.11.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^26",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "@prismatic-io/spectral": "^10.38.5"
  }
}
