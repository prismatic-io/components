{
  "name": "jira-service-management",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.1",
  "scripts": {
    "lint": "biome lint --write .",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "build": "npm run format && npm run lint && tsdown",
    "test": "vitest run",
    "publish": "npm run build && prism components:publish",
    "generate:manifest": "npm run build && npx @prismatic-io/spectral component-manifest",
    "generate:manifest:dev": "npm run build && npx @prismatic-io/spectral component-manifest --skip-signature-verify"
  },
  "dependencies": {
    "@prismatic-io/spectral": "10.32.0",
    "atlassian-utils": "file:../../packages/atlassian-utils",
    "form-data": "4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^26.6.4",
    "nock": "14.0.17",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "overrides": {
    "axios": "1.13.5"
  }
}
