{
  "compilerOptions": {
    "target": "es2018",
    "lib": ["es2018"],
    "module": "esnext",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*", ".spectral/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
