{
  "name": "@prismatic-io/rippling",
  "private": true,
  "license": "Apache-2.0",
  "version": "1.0.0",
  "description": "Rippling integration component for HR, payroll, and workforce management",
  "scripts": {
    "build": "npm run format && npm run lint && tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "publish": "npm run build && prism components:publish --no-confirm"
  },
  "dependencies": {
    "@prismatic-io/spectral": "10.32.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^26.0.1",
    "nock": "14.0.17",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
