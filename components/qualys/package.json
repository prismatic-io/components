{
  "name": "@prismatic-io/qualys",
  "private": true,
  "scripts": {
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "build": "npm run format && npm run lint && webpack",
    "test": "echo 'no tests'",
    "publish": "npm run build && prism components:publish",
    "generate:manifest": "npm run build && npx @prismatic-io/spectral component-manifest",
    "generate:manifest:dev": "npm run build && npx @prismatic-io/spectral component-manifest --skip-signature-verify"
  },
  "dependencies": {
    "@prismatic-io/spectral": "10.26.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "@types/node": "^26",
    "@types/xml2js": "^0.4.14",
    "copy-webpack-plugin": "14.0.0",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2"
  }
}
