{
  "name": "@prismatic-io/aws-lambda",
  "private": true,
  "version": "0.0.1",
  "description": "Amazon Lambda Component for Prismatic",
  "main": "index.ts",
  "scripts": {
    "build": "npm run format && npm run lint && tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "generate-regions-json": "aws ec2 describe-regions | jq '.Regions | map(.RegionName) | sort' > src/aws-regions.json",
    "publish": "npm run build && prism components:publish",
    "test": "echo 'no tests'"
  },
  "dependencies": {
    "aws-utils": "file:../../packages/aws-utils",
    "@aws-sdk/client-lambda": "3.1088.0",
    "@prismatic-io/spectral": "10.34.1"
  },
  "author": "Prismatic",
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^25.3.0",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
