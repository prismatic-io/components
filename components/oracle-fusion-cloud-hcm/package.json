{
  "name": "@prismatic-io/oracle-fusion-cloud-hcm",
  "private": true,
  "scripts": {
    "build": "npm run format && npm run lint && webpack",
    "test": "echo 'no tests'",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "publish": "npm run build && prism components:publish",
    "generate:manifest": "npm run build && npx @prismatic-io/spectral component-manifest",
    "generate:manifest:dev": "npm run build && npx @prismatic-io/spectral component-manifest --skip-signature-verify"
  },
  "dependencies": {
    "@prismatic-io/spectral": "10.25.0",
    "fast-xml-parser": "^5.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^22.20.1",
    "copy-webpack-plugin": "14.0.0",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.109.2",
    "webpack-cli": "6.0.1"
  }
}
