{
	"name": "@prismatic-io/components-google-cloud-storage",
	"version": "0.0.1",
	"main": "./npm-dist/index.cjs",
	"types": "./npm-dist/index.d.cts",
	"exports": {
		".": {
			"types": "./npm-dist/index.d.cts",
			"default": "./npm-dist/index.cjs"
		}
	},
	"description": "Google Cloud Storage integration component for file storage and management operations",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prismatic-io/components.git",
		"directory": "components/google-cloud-storage"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"npm-dist",
		"dist"
	],
	"prismatic": {
		"component": "./dist/index.js"
	},
	"scripts": {
		"build": "npm run format && npm run lint && tsdown",
		"typecheck": "tsc --noEmit",
		"test": "echo 'no tests'",
		"lint": "biome check --write .",
		"format": "biome format --write .",
		"prepare": "npm run build",
		"publish:platform": "npm run build && prism components:publish"
	},
	"peerDependencies": {
		"@prismatic-io/spectral": "^10.39.1"
	},
	"dependencies": {
		"@google-cloud/storage": "7.14.0",
		"xml-js": "^1.6.11"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.5",
		"@types/node": "^26.6.4",
		"tsdown": "0.22.3",
		"typescript": "6.0.3",
		"vitest": "4.1.9",
		"@prismatic-io/spectral": "^10.39.1"
	}
}
