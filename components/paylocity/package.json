{
  "name": "@prismatic-io/components-paylocity",
  "version": "0.1.0",
  "main": "./npm-dist/index.cjs",
  "types": "./npm-dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./npm-dist/index.d.cts",
      "default": "./npm-dist/index.cjs"
    }
  },
  "description": "Paylocity provides a comprehensive product suite and delivers a unified platform for the areas of benefits, core HR, payroll, talent, and workforce management. Use the Paylocity component to connect your workforce management, payroll, and other HR tasks with a variety of applications.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prismatic-io/components.git",
    "directory": "components/paylocity"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "npm-dist",
    "dist"
  ],
  "prismatic": {
    "component": "./dist/index.js"
  },
  "scripts": {
    "build": "npm run format && npm run lint && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests'",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "npm run build",
    "publish:platform": "npm run build && prism components:publish"
  },
  "peerDependencies": {
    "@prismatic-io/spectral": "^10.39.1"
  },
  "dependencies": {
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^25.3.0",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "@prismatic-io/spectral": "^10.39.1",
    "build-config": "file:../../packages/build-config"
  }
}
