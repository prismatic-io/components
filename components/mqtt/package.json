{
  "name": "@prismatic-io/mqtt",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.2",
  "main": "index.js",
  "scripts": {
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "build": "npm run format && npm run lint && tsdown",
    "typecheck": "tsc --noEmit",
    "publish": "npm run build && prism components:publish",
    "generate:manifest": "npm run build && npx @prismatic-io/spectral component-manifest",
    "generate:manifest:dev": "npm run build && npx @prismatic-io/spectral component-manifest --skip-signature-verify",
    "test": "echo 'no tests'"
  },
  "dependencies": {
    "@prismatic-io/spectral": "10.38.5",
    "mqtt": "^5.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "^26.6.4",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
