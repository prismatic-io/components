{
  "name": "oracledb",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "build": "npm run format && npm run lint && tsdown",
    "typecheck": "tsc --noEmit",
    "publish": "npm run build && prism components:publish",
    "generate:manifest": "npm run build && npx @prismatic-io/spectral component-manifest",
    "generate:manifest:dev": "npm run build && npx @prismatic-io/spectral component-manifest --skip-signature-verify",
    "test": "echo 'no tests'"
  },
  "dependencies": {
    "@azure/app-configuration": "^1.9.0",
    "@azure/identity": "^4.8.0",
    "@azure/keyvault-secrets": "^4.9.0",
    "@prismatic-io/spectral": "10.38.5",
    "lodash.merge": "^4.6.2",
    "oci-common": "^2.107.1",
    "oci-objectstorage": "^2.107.1",
    "oci-secrets": "^2.107.1",
    "oracledb": "^6.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^26.6.4",
    "@types/oracledb": "^6.6.0",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
