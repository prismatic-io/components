{
  "name": "@prismatic-io/components-fluent-commerce",
  "version": "0.1.0",
  "main": "./npm-dist/index.cjs",
  "types": "./npm-dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./npm-dist/index.d.cts",
      "default": "./npm-dist/index.cjs"
    }
  },
  "description": "Manage orders within Fluent Commerce",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prismatic-io/components.git",
    "directory": "components/fluent-commerce"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "npm-dist",
    "dist"
  ],
  "prismatic": {
    "component": "./dist/index.js"
  },
  "scripts": {
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "build": "npm run format && npm run lint && tsdown",
    "typecheck": "tsc --noEmit",
    "generate:manifest": "npm run build && npx @prismatic-io/spectral component-manifest",
    "generate:manifest:dev": "npm run build && npx @prismatic-io/spectral component-manifest --skip-signature-verify",
    "test": "vitest run",
    "prepare": "npm run build",
    "publish:platform": "npm run build && prism components:publish"
  },
  "peerDependencies": {
    "@prismatic-io/spectral": "^10.38.5"
  },
  "dependencies": {
    "graphql": "16.14.2",
    "graphql-request": "7.4.0",
    "lodash.merge": "4.6.2",
    "url-join": "4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/lodash.merge": "4.6.7",
    "@types/node": "^26.6.5",
    "@types/url-join": "4.0.0",
    "nock": "14.0.17",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.4",
    "@prismatic-io/spectral": "^10.38.5"
  }
}
