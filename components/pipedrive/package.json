{
  "name": "@prismatic-io/pipedrive",
  "private": true,
  "scripts": {
    "build": "npm run format && npm run lint && tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --write ./",
    "format": "biome format --write . --indent-style=space",
    "publish": "npm run build && prism components:publish",
    "test": "vitest run"
  },
  "dependencies": {
    "@prismatic-io/spectral": "10.32.0",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^26",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
