{
  "name": "@prismatic-io/arena-plm-v2",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "build": "npm run format && npm run lint && tsdown",
    "typecheck": "tsc --noEmit",
    "publish": "npm run build && prism components:publish",
    "test": "vitest run --maxWorkers=4 --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --maxWorkers=4 integration"
  },
  "dependencies": {
    "@prismatic-io/spectral": "10.38.5",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^26.6.4",
    "nock": "14.0.17",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
