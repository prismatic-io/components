{
  "name": "@prismatic-io/components-google-calendar",
  "version": "0.1.0",
  "main": "./npm-dist/index.cjs",
  "types": "./npm-dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./npm-dist/index.d.cts",
      "default": "./npm-dist/index.cjs"
    }
  },
  "description": "Manage calendars and events in Google Calendar",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prismatic-io/components.git",
    "directory": "components/google-calendar"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "npm-dist",
    "dist"
  ],
  "prismatic": {
    "component": "./dist/index.js"
  },
  "scripts": {
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "build": "npm run format && npm run lint && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests'",
    "prepare": "npm run build",
    "publish:platform": "npm run build && prism components:publish"
  },
  "peerDependencies": {
    "@prismatic-io/spectral": "^10.38.5"
  },
  "dependencies": {
    "@googleapis/calendar": "^9.7.9",
    "mime-types": "^2.1.35",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/gapi": "0.0.42",
    "@types/mime-types": "^2.1.1",
    "@types/node": "^26.6.5",
    "@types/uuid": "^9.0.0",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "@prismatic-io/spectral": "^10.38.5"
  }
}
