{
  "compilerOptions": {
    "target": "es6",
    "lib": ["esnext"],
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "strictNullChecks": false,
    "noImplicitAny": false,
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true
  },
  "include": ["src", ".spectral/*"]
}
