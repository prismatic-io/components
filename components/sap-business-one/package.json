{
  "name": "sap-business-one",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "generate:manifest": "npm run build && npx @prismatic-io/spectral component-manifest",
    "generate:manifest:dev": "npm run build && npx @prismatic-io/spectral component-manifest --skip-signature-verify",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "build": "npm run format && npm run lint && tsdown",
    "publish": "npm run build && prism components:publish",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prismatic-io/spectral": "10.32.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/lodash": "^4.17.9",
    "@types/node": "^26.6.4",
    "typescript": "6.0.3",
    "tsdown": "0.22.3",
    "vitest": "4.1.9"
  }
}
