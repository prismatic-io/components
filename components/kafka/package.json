{
  "name": "@prismatic-io/kafka",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "build": "webpack",
    "test": "jest --testPathIgnorePatterns='\\.integration\\.test\\.ts$'",
    "test:integration": "jest src/client.integration.test.ts",
    "publish": "npm run build && prism components:publish",
    "generate:manifest": "npm run build && npx @prismatic-io/spectral component-manifest",
    "generate:manifest:dev": "npm run build && npx @prismatic-io/spectral component-manifest --skip-signature-verify"
  },
  "dependencies": {
    "@kafkajs/confluent-schema-registry": "^3.9.0",
    "@prismatic-io/spectral": "10.26.0",
    "kafkajs": "2.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/jest": "30.0.0",
    "@types/node": "^26",
    "copy-webpack-plugin": "14.0.0",
    "jest": "30.4.2",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2"
  }
}
