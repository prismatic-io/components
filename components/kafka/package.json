{
  "name": "@prismatic-io/kafka",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "build": "npm run format && npm run lint && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts src/client.integration.test.ts",
    "publish": "npm run build && prism components:publish",
    "generate:manifest": "npm run build && npx @prismatic-io/spectral component-manifest",
    "generate:manifest:dev": "npm run build && npx @prismatic-io/spectral component-manifest --skip-signature-verify"
  },
  "dependencies": {
    "@aws-sdk/credential-providers": "3.1143.0",
    "@kafkajs/confluent-schema-registry": "^3.9.0",
    "@prismatic-io/spectral": "10.32.0",
    "aws-msk-iam-sasl-signer-js": "1.0.3",
    "aws-utils": "file:../../packages/aws-utils",
    "kafkajs": "2.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^26",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
