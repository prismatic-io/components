{
  "name": "@prismatic-io/components-google-ads",
  "version": "0.3.0",
  "main": "./npm-dist/index.cjs",
  "types": "./npm-dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./npm-dist/index.d.cts",
      "default": "./npm-dist/index.cjs"
    }
  },
  "description": "Manage campaigns, conversions, customers, and local services in Google Ads.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prismatic-io/components.git",
    "directory": "components/google-ads"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "npm-dist",
    "dist"
  ],
  "prismatic": {
    "component": "./dist/index.js"
  },
  "scripts": {
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "build": "npm run format && npm run lint && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "publish:platform": "npm run build && prism components:publish"
  },
  "peerDependencies": {
    "@prismatic-io/spectral": "^10.39.0"
  },
  "dependencies": {
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/lodash": "4.17.25",
    "@types/node": "^26.6.6",
    "nock": "13.5.6",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "@prismatic-io/spectral": "^10.39.0"
  }
}
