{
  "name": "@prismatic-io/aws-redshift",
  "private": true,
  "scripts": {
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "build": "npm run format && npm run lint && tsdown",
    "typecheck": "tsc --noEmit",
    "publish": "npm run build && prism components:publish",
    "test": "vitest run",
    "generate:manifest": "npm run build && npx @prismatic-io/spectral component-manifest",
    "generate:manifest:dev": "npm run build && npx @prismatic-io/spectral component-manifest --skip-signature-verify"
  },
  "dependencies": {
    "@aws-sdk/client-redshift-data": "3.1088.0",
    "@prismatic-io/spectral": "10.34.1",
    "aws-utils": "file:../../packages/aws-utils",
    "aws4": "^1.13.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/aws4": "^1.11.6",
    "@types/node": "^25.5.0",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
