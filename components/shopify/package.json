  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@rollup/plugin-graphql": "3.0.0",
    "@types/node": "^26",
    "@types/parse-link-header": "^2.0.3",
    "nock": "^14.0.17",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
